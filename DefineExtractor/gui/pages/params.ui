/* params.ui — Python Parameters page */

import { ListView, Button, HorizontalBox, VerticalBox, LineEdit, CheckBox } from "std-widgets.slint";

component ParamsPage inherits VerticalBox {
    spacing: 16px;

    Text {
        text: "PYTHON PARAMETERS";
        font_size: 15px;
        font_weight: 600;
        color: #6366f1;
    }

    HorizontalBox {
        spacing: 12px;
        Text { text: "Python Root:"; font_size: 12px; color: #94a3b8; }
        Text {
            text: root.python_root != "" ? root.python_root : "(not set)";
            font_size: 12px;
            color: #f8fafc;
            horizontal_stretch: 1;
        }
        Rectangle { width: 12px; height: 12px; background: root.python_set ? #22c55e : #ef4444; }
        Button {
            text: "Browse";
            height: 32px;
            enabled: !root.is_running;
            clicked => { browse_python(); }
        }
    }

    HorizontalBox {
        spacing: 8px;

        Button {
            text: "Load";
            height: 34px;
            enabled: !root.is_running && root.python_set;
            clicked => { load_python_params(); debug(); }
        }

        Button {
            text: "Select All";
            height: 34px;
            enabled: !root.is_running && root.params_count > 0;
            clicked => { select_all_params(true); }
        }

        Button {
            text: "Deselect All";
            height: 34px;
            enabled: !root.is_running && root.params_count > 0;
            clicked => { select_all_params(false); }
        }

        HorizontalBox { horizontal_stretch: 1; }

        Text {
            text: root.params_count > 0 ?
                "Selected: " + root.params_selected_count + " / " + root.params_count :
                "(load params first)";
            font_size: 12px;
            color: #94a3b8;
        }
    }

    HorizontalBox {
        spacing: 8px;
        Text { text: "Filter:"; font_size: 12px; color: #94a3b8; }
        LineEdit {
            placeholder_text: "Type to filter...";
            font_size: 14px;
            horizontal_stretch: 1;
            text: root.search_filter;
            edited => {
                root.search_filter = self.text;
                root.filter_changed(self.text);
            }
        }
    }

    VerticalLayout {
        vertical_stretch: 1;
        min_height: 200px;

        if (root.params_count == 0): VerticalBox {
            alignment: center;
            Text {
                text: "No parameters loaded.\nSet Python path and click Load.";
                color: #94a3b8;
                horizontal_alignment: center;
            }
        }

        if (root.params_count > 0): ListView {
            for i in root.params_count: HorizontalBox {
                spacing: 8px;
                CheckBox {
                    checked: root.params_selected[i];
                    toggled => { toggle_param(i); }
                }
                Text {
                    text: root.params_names[i];
                    font_size: 12px;
                    vertical_stretch: 1;
                }
            }
        }
    }

    Button {
        text: root.is_running ? "Extracting..." : "Extract Selected";
        height: 38px;
        enabled: !root.is_running && root.params_selected_count > 0;
        clicked => { run_extraction(); }
    }

    // Properties
    in-out property<string> python_root: "";
    in-out property<bool> python_set: false;
    in-out property<string> search_filter: "";
    in-out property<bool> is_running: false;

    in-out property<[string]> params_names: [];
    in-out property<[bool]> params_selected: [];
    in-out property<int> params_count: 0;
    in-out property<int> params_selected_count: 0;

    // Callbacks
    callback browse_python();
    callback load_python_params();
    callback select_all_params(bool);
    callback toggle_param(int);
    callback run_extraction();
    callback filter_changed(string);
    callback debug();
}
